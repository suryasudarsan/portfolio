{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend-node": {
      "root": "backend-node",
      "framework": "express"
    },
    "backend-python": {
      "root": "backend-python",
      "framework": "flask"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend-node"
      }
    }
  ]
}
