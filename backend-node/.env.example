# ==============================================================
# Cybersecurity Portfolio Backend - Environment Configuration
# ==============================================================
# NOTE: Never commit sensitive production credentials to source control.
# Copy this file to .env and populate the required parameters.

# Server Configuration
PORT=5000
NODE_ENV=development

# Security: Allowed Client Origins for CORS (comma-separated or single URL)
# In production, set strictly to your frontend domain (e.g., https://your-portfolio.com)
CLIENT_URL=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500,http://localhost:8080,http://localhost:5000

# Rate Limiting Configuration
# Standard API limiter: 100 requests per 15 minutes per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Strict Contact Form Limiter: 10 submissions per 15 minutes per IP
CONTACT_LIMIT_WINDOW_MS=900000
CONTACT_LIMIT_MAX=10

# Email Delivery Configuration (Nodemailer)
# If left blank, the backend operates in MOCK/SAFE mode (logs message safely without failing)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_NOTIFICATION_EMAIL=security.engineer@example.com
EMAIL_FROM="Security Portfolio Portal" <no-reply@example.com>
