# ==============================================================
# Cybersecurity Portfolio Backend (Python / Flask) - Environment
# ==============================================================

# Server Configuration
PORT=5001
FLASK_ENV=development
FLASK_DEBUG=False

# Allowed Origins for CORS (comma-separated or single domain)
CLIENT_URL=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500,http://localhost:8080,http://localhost:5000,http://localhost:5001

# Rate Limiter Backend Storage (memory:// or redis://localhost:6379/0)
RATE_LIMIT_STORAGE_URI=memory://

# Contact Form Settings
CONTACT_NOTIFICATION_EMAIL=security.engineer@example.com
MAX_CONTENT_LENGTH=51200 # 50 KB max request payload
